# Server-only Supabase credentials. Never prefix the secret with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Server-only HMAC key (at least 32 random characters) for privacy-preserving rate limits.
RATE_LIMIT_HASH_SECRET=replace_with_at_least_32_random_characters

# Server-only Feishu group robot webhook. Required in Production.
BOOKING_NOTIFICATION_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/replace_me

# Preview/CI only. Browser acceptance sends this in a server-validated request header.
BOOKING_E2E_SECRET=replace_with_preview_only_secret

# Public contact destination used for non-payment booking follow-up.
NEXT_PUBLIC_WHATSAPP_NUMBER=+60123456789
